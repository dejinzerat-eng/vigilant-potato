{
  "name": "dejinzerat",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "build": "pnpm --filter @dej/shared build && pnpm --filter @dej/api build && pnpm --filter @dej/web build",
    "db:migrate": "pnpm --filter @dej/api prisma:migrate",
    "db:seed": "pnpm --filter @dej/api seed",
    "test": "pnpm -r test"
  }
}
